# Shared runtime
AMAP_KEY=your_amap_js_key
AMAP_SECURITY=your_amap_security_js_code
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

LLM_PROVIDER=minimax
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL_ID=MiniMax-M3
LLM_TIMEOUT=300

MAP_STORY_OUTPUT_DIR=artifacts/story_map
MAP_STORY_STATIC_SITE=0
MAP_STORY_GA_MEASUREMENT_ID=G-XXXXXXXXXX
MAP_STORY_VOLCENGINE_APM_AID=1002542
MAP_STORY_VOLCENGINE_APM_TOKEN=your_volcengine_apm_token
MAP_STORY_VOLCENGINE_APM_ENV=prod
STORY_MAP_STRICT_STARTUP=1

# Local development
# If you run the integrated server on 8765, keep the app origin itself in the allowlist.
STORY_MAP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://localhost:5173
MAP_STORY_API_BASE=http://127.0.0.1:8765

# Production deployment example
# Replace these with your OpenDeploy domain or future custom domain.
# STORY_MAP_ALLOWED_ORIGINS=https://storymap.opendeploy.site,https://your-domain.example.com
# MAP_STORY_API_BASE=https://storymap.opendeploy.site

# Graph backend
MAP_STORY_GRAPH_BACKEND=file
MAP_STORY_NEO4J_SYNC=0
MAP_STORY_NEO4J_URI=bolt://127.0.0.1:7687
MAP_STORY_NEO4J_USER=neo4j
MAP_STORY_NEO4J_PASSWORD=your_neo4j_password
MAP_STORY_NEO4J_DATABASE=neo4j
