# AMap
AMAP_KEY=your_amap_js_key
AMAP_SECURITY=your_amap_security_js_code
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

# LLM
LLM_PROVIDER=minimax
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL_ID=MiniMax-M3
LLM_TIMEOUT=300

# Local development
STORY_MAP_ALLOWED_ORIGINS=http://localhost:5173
MAP_STORY_OUTPUT_DIR=artifacts/story_map
MAP_STORY_API_BASE=http://127.0.0.1:8765
MAP_STORY_STATIC_SITE=0
STORY_MAP_STRICT_STARTUP=1

# Graph backend
MAP_STORY_GRAPH_BACKEND=file
MAP_STORY_NEO4J_SYNC=0
MAP_STORY_NEO4J_URI=bolt://127.0.0.1:7687
MAP_STORY_NEO4J_USER=neo4j
MAP_STORY_NEO4J_PASSWORD=your_neo4j_password
MAP_STORY_NEO4J_DATABASE=neo4j

# Legacy aliases like `Amap_API_Key` / `Amap_API_Secret` / `location_api`
# are still supported, but new configuration should prefer the canonical names above.
